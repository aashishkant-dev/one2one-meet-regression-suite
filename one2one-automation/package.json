{
  "name": "one2one-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Curated post-deploy smoke suite for One2One Meet - the essential checks to run after any change, instead of testing everything by hand.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:auth": "playwright test tests/auth",
    "test:core-crud": "playwright test tests/core-crud",
    "test:concurrency": "playwright test tests/concurrency",
    "test:booking": "playwright test tests/booking",
    "test:meeting-request": "playwright test tests/meeting-request",
    "test:event-state": "playwright test tests/event-state"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
